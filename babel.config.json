{
  "presets": [
    [
      "@babel/preset-env",
      {
        "modules": false,
        "targets": ">0.25%, not dead",  // targets modern browsers with broad support
        "useBuiltIns": "entry",
        "corejs": 3
      }
    ],
    [
      "@babel/preset-react",
      {
        "runtime": "automatic"
      }
    ],
    "@babel/preset-typescript"
  ],
  "plugins": [
    "babel-plugin-macros",
    [
      "@babel/plugin-transform-runtime",
      {
        "regenerator": true,          // enable regenerator runtime for async/await
        "useESModules": true
      }
    ]
  ],
  "env": {
    "test": {
      "presets": [
        [
          "@babel/preset-env",
          {
            "targets": {
              "node": "current"
            }
          }
        ]
      ]
    }
  }
}
